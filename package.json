{
  "name": "vscode-magic-comment",
  "displayName": "VSCode Magic Comment",
  "version": "0.0.6",
  "private": true,
  "description": "Add annotations to magic comments",
  "categories": [
    "Other"
  ],
  "keywords": [],
  "homepage": "https://github.com/ntnyq/vscode-magic-comment",
  "bugs": {
    "url": "https://github.com/ntnyq/vscode-magic-comment/issues/new"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "github",
    "url": "https://github.com/ntnyq/vscode-magic-comment.git"
  },
  "publisher": "ntnyq",
  "files": [
    "LICENSE",
    "dist/*",
    "res/*"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:meta": "vscode-ext-gen --output src/meta.ts --scope magic-comment",
    "lint": "oxlint",
    "pack": "vsce package --no-dependencies",
    "prepare": "husky",
    "release": "run-s release:check release:version release:publish",
    "release:build": "run-s generate:meta build",
    "release:check": "run-s lint typecheck",
    "release:publish": "vsce publish --no-dependencies",
    "release:version": "bumpp --all --execute='pnpm release:build'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "reactive-vscode": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "vscode-ext-gen": "^1.6.0"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "contributes": {
    "commands": [
      {
        "category": "Magic Comment",
        "command": "magic-comment.getLanguageConfig",
        "title": "getLanguageConfig"
      }
    ],
    "configuration": {
      "properties": {
        "magic-comment.annotation": {
          "additionalProperties": false,
          "description": "Magic comment annotation",
          "properties": {
            "after": {
              "additionalProperties": false,
              "properties": {
                "contentText": {
                  "default": "🚀",
                  "type": "string"
                },
                "margin": {
                  "default": "0 0 0 0.5em",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "color": {
              "default": "rgb(255, 189, 42)",
              "description": "Color of annotation",
              "format": "color",
              "type": "string"
            }
          },
          "type": "object",
          "scope": "language-overridable"
        },
        "magic-comment.customMagicComments": {
          "default": [],
          "description": "User defined magic comments",
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "patterns": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind",
                            "tokens",
                            "syntax"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "token"
                              ]
                            },
                            "tokens": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "syntax": {
                              "type": "array",
                              "minItems": 1,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "enum": [
                                  "line",
                                  "block",
                                  "html",
                                  "hash"
                                ]
                              }
                            },
                            "trailing": {
                              "type": "string",
                              "enum": [
                                "none",
                                "line",
                                "multiline"
                              ],
                              "default": "none"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind",
                            "source"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "regex"
                              ]
                            },
                            "source": {
                              "type": "string"
                            },
                            "flags": {
                              "type": "string",
                              "description": "JavaScript regex flags; scanning adds d and g, defaults to u, and removes y."
                            },
                            "capture": {
                              "type": "integer",
                              "minimum": 0,
                              "default": 1
                            }
                          }
                        }
                      ]
                    }
                  }
                ],
                "description": "Legacy regex source(s), or pattern declarations. Regex capture defaults to group 1."
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "patterns"
            ],
            "type": "object"
          },
          "type": "array",
          "scope": "language-overridable"
        },
        "magic-comment.disabledCategories": {
          "default": [],
          "description": "Disabled by comments category",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true,
          "scope": "language-overridable"
        },
        "magic-comment.disabledNames": {
          "default": [],
          "description": "Disabled by comments name",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true,
          "scope": "language-overridable"
        },
        "magic-comment.enable": {
          "default": true,
          "description": "Enable extension",
          "type": "boolean",
          "scope": "language-overridable"
        },
        "magic-comment.ignorePaths": {
          "default": [],
          "description": "Ignored glob patterns, relative to the workspace folder or absolute outside a workspace",
          "items": {
            "type": "string"
          },
          "type": "array",
          "scope": "language-overridable"
        },
        "magic-comment.languages": {
          "default": [
            "javascript",
            "javascriptreact",
            "markdown",
            "typescript",
            "typescriptreact"
          ],
          "description": "Enabled by language ids",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true,
          "scope": "language-overridable"
        }
      },
      "title": "Magic Comment"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "./res/logo.png",
  "preview": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "packageManager": "pnpm@12.11.2"
}
